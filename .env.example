# Backend environment — copy to .env for local dev.
# Production: secrets come from the vault, not this file.

# ── Database ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5434/cia
DB_USERNAME=cia
DB_PASSWORD=cia_dev

# ── NDPR PII encryption (pgcrypto) ────────────────────────────────────────
# CRITICAL: losing this key = unrecoverable customer PII. Replace in prod.
PII_ENCRYPTION_KEY=dev-pii-key-do-not-use-in-prod-CHANGE-ME

# ── Keycloak (auth) ───────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8280
KEYCLOAK_REALM=cia

# ── Keycloak admin proxy (Module 1 Users page) ────────────────────────────
# Two modes:
#   DEV  → admin-cli + master admin password (matches docker-compose).
#   PROD → confidential service-account client with realm-management role.
# Toggle KEYCLOAK_ADMIN_ENABLED=true to wire the admin bean.
KEYCLOAK_ADMIN_ENABLED=true
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# DEV: password grant against admin-cli.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# PROD: client-credentials grant — leave USERNAME/PASSWORD unset, set this.
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Temporal ──────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Storage (MinIO in docker-compose) ─────────────────────────────────────
STORAGE_TYPE=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=cia-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ── Redis (partner-API rate limiting) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ── External integrations (stub in dev) ───────────────────────────────────
NAICOM_MODE=stub
NIID_MODE=stub
KYC_PROVIDER=mock
