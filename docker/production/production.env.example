# Copy to .env.production in the deployment environment and source values from
# a secret manager. These placeholders are deliberately non-local but are not
# valid credentials.

CIA_BACKEND_IMAGE=ghcr.io/razormvp/coreinsurance/cia-backend:latest
SPRING_PROFILES_ACTIVE=prod
CIA_ENV=prod
SERVER_PORT=8090

DB_URL=jdbc:postgresql://postgres.prod.example.internal:5432/cia
DB_USERNAME=cia_app
DB_PASSWORD=replace-with-secret

KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=cia

REDIS_HOST=redis.prod.example.internal
REDIS_PORT=6379

TEMPORAL_HOST=temporal.prod.example.internal:7233
TEMPORAL_NAMESPACE=production

STORAGE_TYPE=s3
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_BUCKET=cia-documents-prod
STORAGE_ACCESS_KEY=replace-with-secret
STORAGE_SECRET_KEY=replace-with-secret
STORAGE_REGION=af-south-1

PII_ENCRYPTION_KEY=replace-with-32-plus-random-bytes-from-vault
WEBHOOK_SIGNING_SECRET=replace-with-32-plus-random-bytes-from-vault
PARTNER_TOKEN_URL=https://auth.example.com/realms/cia/protocol/openid-connect/token

KYC_PROVIDER=dojah
KYC_PROVIDER_URL=https://kyc-provider.example.com
NAICOM_MODE=live
NAICOM_API_URL=https://naicom.example.com
NIID_MODE=live
NIID_API_URL=https://niid.example.com

EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-secret
SMTP_PASSWORD=replace-with-secret

RATE_LIMIT_ENABLED=true
PARTNER_RATE_LIMIT_RPM=300
SENSITIVE_RATE_LIMIT_RPM=60
FAILED_LOGIN_RATE_LIMIT_RPM=10
