  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <lombok.version>1.18.46</lombok.version>
    <!-- 1.25.0 -> 1.35.0 to pull fixed grpc (1.54->1.75) + protobuf
         (3.21->3.25): clears the Temporal-transitive image CVEs
         (CVE-2025-55163, CVE-2023-32731, CVE-2024-7254). -->
    <temporal.version>1.35.0</temporal.version>
    <!-- Spring Boot 3.5.14 BOM overrides — these three property names match the
         spring-boot-dependencies BOM, so setting them here overrides the managed
         versions to the latest patch in each line, clearing 2026-dated image CVEs
         whose fixes post-date the BOM pins (Tomcat 10.1.54->.55 CVE-2026-41293
         CRITICAL; netty 4.1.132->.135 — .134 cleared CVE-2026-42583/42579/42584,
         .135 clears the 2026-06 HIGHs CVE-2026-44249/45416 (netty-handler) +
         CVE-2026-45674/47691 (netty-resolver-dns); .136 clears the 2026-07
         HIGHs CVE-2026-59901 (netty-codec Bzip2Decoder infinite loop) +
         CVE-2026-55831/55833/56745 (netty-codec-http); pgjdbc
         42.7.10->.11 CVE-2026-42198, .12 CVE-2026-54291). -->
    <tomcat.version>10.1.55</tomcat.version>
    <netty.version>4.1.136.Final</netty.version>
    <postgresql.version>42.7.12</postgresql.version>
    <!-- spring-framework is a Boot BOM property too: the 3.5.14 BOM pins Spring
         Framework 6.2.18, which four 2026-07 HIGH CVEs flag — CVE-2026-41850
         (spring-expression SpEL DoS), CVE-2026-41842 (spring-webflux DoS) and
         CVE-2026-41845 (reflected XSS) among them. 6.2.19 is the same-line patch
         carrying all fixes (drop-in, no API change). Override here, same
         mechanism as tomcat/netty/postgresql above. -->
    <spring-framework.version>6.2.19</spring-framework.version>
    <!-- spring-data-bom is a Boot BOM property too: the 3.5.14 BOM pins the
         Spring Data 2025.0.11 release train (spring-data-commons 3.5.11), which
         CVE-2026-41695 (Spring Data Commons DoS, HIGH) flags. The 2025.0.12
         train ships spring-data-commons 3.5.12 with the fix (same-line patch,
         drop-in, no API change). Override here, same mechanism as the other
         Boot-BOM-property pins above. -->
    <spring-data-bom.version>2025.0.12</spring-data-bom.version>
    <!-- jackson-bom is a Boot BOM property too: the 3.5.14 BOM pins jackson
         2.21.2, which two 2026-06 HIGH CVEs flag — CVE-2026-54512
         (PolymorphicTypeValidator bypass) + CVE-2026-54513 (array subtype
         allowlist bypass). 2.21.4 is the same-line patch carrying both fixes
         (drop-in, no API change). Override here, same mechanism as tomcat/
         netty/postgresql above. -->
    <jackson-bom.version>2.21.4</jackson-bom.version>
    <!-- bcprov-jdk18on is NOT a Boot BOM property; minio 8.6.0 pins it
         transitively at 1.81 (CVE-2026-5598 HIGH — non-constant-time comparison
         private-key leak). A <properties> value alone is a no-op here; it must be
         forced via an explicit <dependencyManagement> entry (see below, next to
         the okhttp pin — another minio transitive Boot doesn't manage). 1.84
         carries the fix. -->
    <bouncy-castle.version>1.84</bouncy-castle.version>
    <mapstruct.version>1.5.5.Final</mapstruct.version>
    <!-- 2.5.0 -> 2.8.17: springdoc 2.5.0 targets Spring 6.1 and calls the
         ControllerAdviceBean(Object) ctor that Spring 6.2 (Boot 3.5.14) removed,
         so live /partner/v3/api-docs/** + the /partner/docs Swagger UI 500 at
         runtime (NoSuchMethodError) — latent since the S144 Boot 3.3.5->3.5.14
         bump because the committed OpenAPI/Postman snapshots are static. The
         2.8.x line is built against Spring 6.2; .17 is the latest patch. -->
    <springdoc.version>2.8.17</springdoc.version>
    <pdfbox.version>3.0.2</pdfbox.version>
    <minio.version>8.6.0</minio.version>
    <!-- OkHttp is no longer managed by the Spring Boot BOM as of 3.5 (Boot
         dropped it). minio 8.6.0 declares okhttp 5.1.0 transitively, but
         okhttp 5 restructured HttpUrl/core types (Kotlin split jar) and breaks
         minio's compile against our classpath ("cannot access okhttp3.HttpUrl").
         minio's usage is okhttp-4-API-compatible, okhttp 4.12.0 is CVE-clean
         (Trivy flagged none), and 4.12.0 keeps HttpUrl in its classic location
         — so we pin 4.12.0 to avoid the okhttp-5 migration entirely. -->
    <okhttp.version>4.12.0</okhttp.version>
    <aws-sdk.version>2.25.60</aws-sdk.version>
    <bucket4j-starter.version>0.12.7</bucket4j-starter.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <!--
      docker-java 3.4.x defaults to Docker API v1.30, which Docker Engine 29.x
      rejects with HTTP 400 (MinAPIVersion is 1.40). Testcontainers 1.21.4's BOM
      still pins docker-java 3.4.2, so we explicitly override to 3.5.3 (first
      release that raised the negotiated baseline). Without this override every
      Testcontainers IT fails on Docker Desktop 29+ with
      "Could not find a valid Docker environment".
    -->
    <docker-java.version>3.5.3</docker-java.version>
    <!--
      ByteBuddy 1.14.x (bundled by Mockito 5.11.0 via spring-boot-starter-test)
      cannot redefine bytecode on JDK 25, throwing
      "MockitoException: Could not modify all classes [..., class java.lang.Object]"
      on every Mockito.mock(...). 1.15.x added JDK-25 support. CI runs on JDK 21
      where 1.14.19 works fine; the override exists so local dev on JDK 25 doesn't
      have to wait for CI just to see "test passes." Pinned ahead of Spring Boot's
      managed version so first-declaration-wins ordering takes effect.
    -->
    <byte-buddy.version>1.15.11</byte-buddy.version>
    <!--
      Keycloak admin client — used by cia-setup UserService to proxy user
      CRUD + reset-password + activate/deactivate against Keycloak. 26.x
      tracks the running Keycloak server version per docker-compose
      (keycloak:24+; admin-client maintains backwards compatibility).
    -->
    <keycloak-admin-client.version>26.0.2</keycloak-admin-client.version>
  </properties>

