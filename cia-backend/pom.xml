      <!-- ── ByteBuddy override for JDK 25 (must come BEFORE Spring Boot BOM
           via being declared in <dependencyManagement>). See properties
           block above for the rationale. -->
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>${byte-buddy.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy-agent</artifactId>
        <version>${byte-buddy.version}</version>
      </dependency>

      <!-- ── docker-java override (must come BEFORE testcontainers-bom) ─
           Docker 29.x requires API >= 1.40 (MinAPIVersion=1.40). docker-java
           3.4.x defaults to v1.30 and gets HTTP 400 on every probe. 3.5.x
           raises the baseline. First-declaration-wins ordering means we must
           pin docker-java explicitly above the Testcontainers BOM import. -->
      <dependency>
        <groupId>com.github.docker-java</groupId>
        <artifactId>docker-java-api</artifactId>
        <version>${docker-java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.docker-java</groupId>
        <artifactId>docker-java-transport</artifactId>
        <version>${docker-java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.docker-java</groupId>
        <artifactId>docker-java-transport-zerodep</artifactId>
        <version>${docker-java.version}</version>
      </dependency>

      <!-- ── Testcontainers BOM ────────────────────────────────────── -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- ── testcontainers-keycloak (third-party, not in Testcontainers BOM)
           Provides KeycloakContainer for ITs that exercise the Keycloak admin
           client. Used by F1e-IT (S118) + downstream syncer + fanout ITs.
           Pinned here so child modules don't have to repeat the version. ── -->
      <dependency>
        <groupId>com.github.dasniko</groupId>
        <artifactId>testcontainers-keycloak</artifactId>
        <version>3.5.1</version>
        <scope>test</scope>
      </dependency>

