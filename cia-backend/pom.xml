        <scope>test</scope>
      </dependency>

      <!-- ── MapStruct ─────────────────────────────────────────────── -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <!-- ── Springdoc OpenAPI ─────────────────────────────────────── -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- swagger-annotations standalone — used by business modules that
           annotate internal controllers with @Operation / @ApiResponses /
           @Tag but do not need the Swagger UI. Version MUST match what
           springdoc-openapi-starter-webmvc-ui transitively brings (it ships
           swagger-*-jakarta 2.2.47, which provides the same
           io.swagger.v3.oas.annotations.media.Schema class): springdoc 2.8.17's
           GenericResponseService calls Schema.$dynamicRef(), absent before
           2.2.30 — so a stale 2.2.22 here shadows the method and 500s every
           /partner/v3/api-docs/** request. 2.2.22 -> 2.2.47 with the springdoc
           2.5.0 -> 2.8.17 bump. (Dedup to swagger-annotations-jakarta is a
           follow-up: swagger-annotations-jakarta-migration.) -->
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
        <version>2.2.47</version>
      </dependency>

      <!-- ── PDF generation ────────────────────────────────────────── -->
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>

      <!-- ── MinIO client ──────────────────────────────────────────── -->
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>

      <!-- ── OkHttp (minio transitive; unmanaged by Boot 3.5+) ──────── -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp</artifactId>
        <version>${okhttp.version}</version>
      </dependency>

      <!-- ── BouncyCastle (minio transitive; not BOM-managed) ────────
           minio 8.6.0 pins bcprov-jdk18on 1.81 (CVE-2026-5598 HIGH). Force the
           fixed 1.84 — the <properties> override above does nothing without this
           explicit management entry. -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncy-castle.version}</version>
      </dependency>

      <!-- ── AWS SDK v2 BOM ─────────────────────────────────────────── -->
